{
  "name": "moonguard-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MoonGuard local file workspace: preview, validate, execute and recover with MoonBit.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node host/server.mjs",
    "test": "node --test host/tests/*.test.mjs",
    "core:test": "moon test --target js",
    "build": "moon run scripts/build.mbtx",
    "cli": "node host/cli.mjs",
    "mcp": "node integrations/mcp/server.mjs",
    "test:mcp": "npm --prefix integrations/mcp test",
    "study:report": "node host/study-report.mjs",
    "test:ui": "npm --prefix integrations/ui test"
  },
  "license": "Apache-2.0"
}
